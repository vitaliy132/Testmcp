/media/a22769_8644903634f14479a29ceb8c3c0e53f3.jpg/v1/fill/w_1200,h_1200,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/a22769_8644903634f14479a29ceb8c3c0e53f3.jpg"],"journal":[{"title":"A studio in a renovated Greek house","dek":"Architecture, furniture, and a concept store under one Fethiye roof.","image":"https://static.wixstatic.com/media/a22769_5374837cbfbb41398cc39ad2208a79ad~mv2.jpg/v1/fill/w_1200,h_900,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/a22769_5374837cbfbb41398cc39ad2208a79ad~mv2.jpg"},{"title":"Mudalla geometry","dek":"Octahedrons, marble triangles, and pieces that change with every viewing angle.","image":"https://static.wixstatic.com/media/a22769_548ec3092ea24c679e985b4851eb2af9~mv2_d_6354_3000_s_4_2.jpg/v1/fill/w_1200,h_700,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/a22769_548ec3092ea24c679e985b4851eb2af9~mv2_d_6354_3000_s_4_2.jpg"},{"title":"Mediterranean living","dek":"Honouring local artisans while drawing a precise, minimal line.","image":"https://static.wixstatic.com/media/a22769_60d4a325b0cb40bb8b62d851768f7509~mv2.jpg/v1/fill/w_1200,h_700,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/a22769_60d4a325b0cb40bb8b62d851768f7509~mv2.jpg"}],"faqs":[{"q":"How can I place an order?","a":"We accept Visa, Mastercard, and American Express online. You can also order by phone or email. Once placed, you will receive confirmation by e-mail. Call +90 542 636 40 04 or write to info@emnastudio.com. We sell to public and trade."},{"q":"What about your privacy policy?","a":"Credit-card details are encrypted and never stored. Personal data is not sold. We collect name and email as part of checkout, and may send store updates if you opt in — unsubscribe anytime."},{"q":"Can I cancel a placed order?","a":"Yes, within 48 hours. Custom and special orders can be cancelled within 24 hours. Contact the studio if you need help."},{"q":"Can I return an item?","a":"Returns last 14 days from reception. Items must be unused and in original packaging. Inspect on delivery — visible damage should be refused and emailed with photos within 24 hours. Shipping costs are non-refundable except for damaged goods."},{"q":"What are your shipping and delivery conditions?","a":"EMNA ships worldwide. Most designs are handmade, unique, or limited edition; special orders take 6–8 weeks. Shipping fees depend on package size, services, and destination. A quote is sent with the order confirmation. Free shipping on orders over 4000 TL."},{"q":"Is the wood changing over time?","a":"Wood is a living material. Pieces are dried to limit movement, but minor shrinkage, warpage, or colour change can appear with humidity, sunlight, or moisture. Those marks are part of the material and are not grounds for return."},{"q":"What is the philosophy behind your fashion collection?","a":"Wear Me emphasises sustainability: ethically made designs crafted in Turkey, with a focus on quality, style, and environmental responsibility."},{"q":"Do you offer gift options?","a":"Yes — a curated selection of unique gift ideas, plus gift cards. Explore Gift ideas in the concept store."},{"q":"Are your furniture pieces available in large quantities?","a":"No. Pieces are one-of-a-kind or limited edition. Larger-scale production is available for custom projects — start a project with the studio."},{"q":"What makes EMNA Studio products unique?","a":"They are handcrafted by Turkish designers and artisans, blending traditional craftsmanship with modern geometry. Each piece is curated to sit inside the studio’s philosophy."},{"q":"What can I expect from your tableware collection?","a":"Handmade designs that mix function and artistry — everyday dining treated as a special experience."}],"products":[{"id":"trocta-coffeetable","title":"TROCTA Coffee Table","price":10119,"collections":["furniture","new","giftideas"],"images":["https://static.wixstatic.com/media/a22769_aa7241908b224269868c841be37ca10d~mv2_d_3456_3456_s_4_2.png/v1/fill/w_900,h_900,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/a22769_aa7241908b224269868c841be37ca10d~mv2_d_3456_3456_s_4_2.png","https://static.wixstatic.com/media/a22769_548ec3092ea24c679e985b4851eb2af9~mv2_d_6354_3000_s_4_2.jpg/v1/fill/w_1200,h_700,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/a22769_548ec3092ea24c679e985b4851eb2af9~mv2_d_6354_3000_s_4_2.jpg","https://static.wixstatic.com/media/a22769_d7450d1a80594e578c90da2b7417fd66~mv2_d_4488_4487_s_4_2.jpg/v1/fill/w_900,h_900,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/a22769_d7450d1a80594e578c90da2b7417fd66~mv2_d_4488_4487_s_4_2.jpg"],"description":"TROCTA is a powder-coated metal wire octahedron — hand-bent and welded — supporting a CNC-cut marble top. The top deconstructs the triangle, assembled from different marbles so colour combinations keep surprising you. Like all Mudalla pieces, it seems to change from each viewing angle.","size":"W 64cm × D 55cm × H 45cm","material":"Powder-coated metal structure, CNC-cut and hand-polished marble top. Handcrafted limited edition; other colours available."},{"id":"kayla-console","title":"KAYLA Console","price":15210,"collections":["furniture"],"images":["https://static.wixstatic.com/media/a22769_fb4169432c774dee9dd2b26bdbaf6938.jpg/v1/fill/w_900,h_900,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/a22769_fb4169432c774dee9dd2b26bdbaf6938.jpg","https://static.wixstatic.com/media/a22769_bd0abbeb3cb048f9ba1b7d7eedc748a8.jpg/v1/fill/w_1200,h_700,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/a22769_bd0abbeb3cb048f9ba1b7d7eedc748a8.jpg"],"description":"KAYLA is inspired by the architectural portico. A metal base supports a chestnut wood top — elegant and simple, at home in a variety of interiors. Available in different sizes.","size":"W 132cm × D 46cm × H 85cm","material":"Chestnut wood, matte natural finishing. Metal legs with electrostatic coating."},{"id":"jazia-bench","title":"JAZIA Bench","price":36485,"collections":["furniture"],"images":["https://static.wixstatic.com/media/a22769